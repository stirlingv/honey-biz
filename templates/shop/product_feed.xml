{% autoescape on %}<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:g="http://base.google.com/ns/1.0">
  <channel>
    <title>Bear Creek Apiaries &amp; Honey LLC</title>
    <link>{{ site_url }}</link>
    <description>Local raw honey and gift jars from Bear Creek Apiaries in Tallahassee, FL.</description>
{% for item in items %}    <item>
      <g:id>{{ item.id }}</g:id>
      <g:title>{{ item.title }}</g:title>
      <g:description>{{ item.description }}</g:description>
      <g:link>{{ item.link }}</g:link>
{% if item.image_link %}      <g:image_link>{{ item.image_link }}</g:image_link>
{% endif %}      <g:availability>{{ item.availability }}</g:availability>
      <g:price>{{ item.price }}</g:price>
      <g:brand>{{ item.brand }}</g:brand>
      <g:condition>{{ item.condition }}</g:condition>
    </item>
{% endfor %}  </channel>
</rss>
{% endautoescape %}
